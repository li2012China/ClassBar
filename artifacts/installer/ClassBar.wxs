<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="ClassBar"
           Manufacturer="li2012China"
           Version="2.1.0.0"
           UpgradeCode="4E2A9C11-8B3D-4F5A-9C21-7D6B5E4A1F03"
           Scope="perUser"
           Language="2052"
           Codepage="65001"
           InstallerVersion="500"
           Compressed="yes">

    <SummaryInformation Description="ClassBar 课表显示工具 安装程序"
                        Manufacturer="li2012China"/>

    <MajorUpgrade DowngradeErrorMessage="已安装较新版本的 ClassBar，请先卸载现有版本后再安装。"/>
    <MediaTemplate EmbedCab="yes" CompressionLevel="high"/>

    <!-- 按用户安装到 %LocalAppData%\Programs\ClassBar，无需管理员权限 -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="ClassBar"/>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="ClassBar" Level="1">
      <ComponentGroupRef Id="AppFilesGroup"/>
      <ComponentRef Id="AppShortcuts"/>
    </Feature>

    <Icon Id="AppIcon" SourceFile="AppLogo.ico"/>
    <Property Id="ARPPRODUCTICON" Value="AppIcon"/>
    <Property Id="ARPNOMODIFY" Value="1"/>
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize"/>

  </Package>

  <Fragment>
    <ComponentGroup Id="AppFilesGroup" Directory="INSTALLFOLDER">
      <Files Include="win_app\**"/>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="AppShortcuts" Guid="8F3C2A64-1D75-4B92-8E60-3A9B7C51D2E8">
        <Shortcut Id="StartMenuShortcut"
                  Name="ClassBar"
                  Description="ClassBar 课表显示工具"
                  Target="[INSTALLFOLDER]ClassIsland.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon"
                  Directory="ProgramMenuFolder"/>
        <Shortcut Id="DesktopShortcut"
                  Name="ClassBar"
                  Description="ClassBar 课表显示工具"
                  Target="[INSTALLFOLDER]ClassIsland.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon"
                  Directory="DesktopFolder"/>
        <RegistryValue Root="HKCU"
                       Key="Software\li2012China\ClassBar"
                       Name="InstallLocation"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>
  </Fragment>

</Wix>
